{
  "name": "@safekids-ai/ml-models",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "ts-patch install -s",
    "release:silent": "dotenv release-it --ci",
    "build": "APP_ENV=production NODE_ENV=production nx run-many -t build --configuration=production",
    "build:debug": "nx run-many -t build --verbose",
    "build:debug:nocache": "nx run-many -t build --verbose --skip-nx-cache",
    "test": "nx run-many -t clean,build,test --skip-nx-cache --projects=nlp-js-common,nlp-js-node,nlp-js-web,vision-js-common,vision-js-node,vision-js-web,ml-api-web-demo,gmail-extension",
    "release": "dotenv release-it --",
    "release:dist:only": "release-it --no-increment --no-npm --no-git --no-github.release --no-plugins --ci",
    "publish:npm": "nx run-many --target=publish --projects=nlp-js-common,nlp-js-node,nlp-js-web,vision-js-common,vision-js-node,vision-js-web --parallel=false",
    "gmail": "APP_ENV=production NODE_ENV=production nx run gmail-extension:build --configuration=production",
    "gmail:dev": "APP_ENV=development NODE_ENV=development nx run gmail-extension:build --configuration=development --watch",
    "webfilter": "APP_ENV=production NODE_ENV=production nx run web-filter-extension:build --configuration=production",
    "webfilter:dev": "APP_ENV=development NODE_ENV=development nx run web-filter-extension:build --configuration=development --watch",
    "companion": "APP_ENV=production NODE_ENV=production nx run web-filter-extension-companion:build --configuration=production",
    "companion:dev": "APP_ENV=development NODE_ENV=development nx run web-filter-extension-companion:build --configuration=development --watch",
    "homepage": "APP_ENV=production NODE_ENV=production nx build main-website-react --configuration=production",
    "homepage:dev": "APP_ENV=development NODE_ENV=development nx serve main-website-react --configuration=development",
    "api": "APP_ENV=production NODE_ENV=production nx build ml-api --configuration=production",
    "api:dev": "APP_ENV=development NODE_ENV=development nx serve ml-api --configuration=development --watch",
    "web": "APP_ENV=production NODE_ENV=production nx build ml-api-web --configuration=production",
    "web:dev": "APP_ENV=development NODE_ENV=development nx serve ml-api-web --configuration=development",
    "web-demo": "APP_ENV=production NODE_ENV=production nx build ml-api-web-demo --configuration=production",
    "web-demo:dev": "APP_ENV=development NODE_ENV=development nx serve ml-api-web-demo --configuration=development",
    "lint": "nx workspace-lint && nx lint",
    "e2e": "nx e2e ml-api-e2e --skip-nx-cache",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "update": "nx migrate latest",
    "workspace-generator": "nx workspace-generator",
    "dep-graph": "nx dep-graph",
    "help": "nx help"
  },
